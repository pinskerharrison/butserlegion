---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
interface Props { src: string; alt: string; class?: string; eager?: boolean; }
const { src, alt, class: className, eager = false } = Astro.props;
const images = import.meta.glob<{ default: ImageMetadata }>('/src/assets/images/**/*.{jpg,jpeg,png,webp,avif}', { eager: true });
const asset = images[src]?.default;
if (!asset) throw new Error(`Image not found: ${src}. Choose an existing image in Pages CMS.`);
---
<Image src={asset} alt={alt} class={className} widths={[480, 800, 1200, 1800].filter(w => w <= asset.width)} sizes="(max-width: 700px) 100vw, 85vw" format="webp" loading={eager ? 'eager' : 'lazy'} fetchpriority={eager ? 'high' : 'auto'} />
