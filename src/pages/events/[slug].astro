---
import { getCollection, render } from 'astro:content';
import { withBase } from '../../lib/paths';
import Layout from '../../layouts/Layout.astro';
import Photo from '../../components/Photo.astro';
import Arrow from '../../components/Arrow.astro';
import { formatDate, isUpcoming, londonDateTime } from '../../lib/events.mjs';
export async function getStaticPaths() {
  const events = await getCollection('events');
  const slugs = events.map(e => e.data.slug);
  if (new Set(slugs).size !== slugs.length) throw new Error('Event slugs must be unique.');
  if (slugs.includes('archive')) throw new Error('The event slug archive is reserved.');
  return events.map(event => ({ params: { slug: event.data.slug }, props: { event } }));
}
const { event } = Astro.props;
const e = event.data;
const { Content } = await render(event);
const structured = { '@context': 'https://schema.org', '@type': 'Event', name: e.title, description: e.summary, startDate: londonDateTime(e.startDate, e.startTime), ...(e.endTime ? { endDate: londonDateTime(e.endDate || e.startDate, e.endTime) } : e.endDate ? { endDate: e.endDate } : {}), eventStatus: `https://schema.org/${e.cancelled ? 'EventCancelled' : 'EventScheduled'}`, eventAttendanceMode: 'https://schema.org/OfflineEventAttendanceMode', url: new URL(withBase(`/events/${e.slug}/`), Astro.site).href, location: { '@type': 'Place', name: e.venue, address: e.address }, organizer: { '@type': 'Organization', name: 'Butser IX Legion', url: Astro.site?.href } };
---
<Layout title={e.title} description={e.summary}>
  <script slot="head" type="application/ld+json" is:inline set:html={JSON.stringify(structured).replace(/</g, '\u003c')} />
  <section class="page-heading"><div><a class="breadcrumb" href={withBase('/events/')}>Events /</a><h1>{e.title}</h1><p class="lead">{e.summary}</p>{e.cancelled && <p class="status">This event has been cancelled. Please do not travel for this event.</p>}{!isUpcoming(e) && <p class="past-notice">This event has ended. <a href={withBase('/events/')}>See upcoming events.</a></p>}</div></section>
  <div class="article-layout section-wrap"><article class="prose">{e.image && <Photo src={e.image} alt={e.imageAlt!} />}<h2>About this event</h2><Content /><p>All advertised times are local UK time. Please check with the venue for admission and any changes before setting out.</p><a class="text-link" href={withBase('/events/')}>Back to all events <Arrow /></a></article><aside class="contact-panel event-details"><h2>Your visit</h2><dl><dt>Date</dt><dd><time datetime={e.startDate}>{formatDate(e.startDate, { weekday: 'long', day: 'numeric', month: 'long', year: 'numeric' })}</time>{e.endDate && e.endDate !== e.startDate && <> – <time datetime={e.endDate}>{formatDate(e.endDate)}</time></>}</dd><dt>Time</dt><dd>{e.startTime}{e.endTime && `–${e.endTime}`} (UK time)</dd><dt>Venue</dt><dd>{e.venue}<br />{e.address}</dd></dl>{e.externalUrl && <a class="button button-dark" href={e.externalUrl}>Venue information <Arrow /></a>}<a class="text-link" href={withBase('/contact/')}>Contact the Legion</a></aside></div>
</Layout>
