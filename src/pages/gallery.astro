---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import Photo from '../components/Photo.astro';
const photos = (await getCollection('gallery')).sort((a,b) => a.data.order - b.data.order);
---
<Layout title="Gallery" description="Photographs of the Butser IX Legion: Roman reenactment, armour and life at Butser Ancient Farm."><section class="page-heading"><div><h1>The past,<br />in good company.</h1><p class="lead">A few moments from life with the Legion. Real people, shared curiosity and Roman history within reach.</p></div></section><section class="gallery section-wrap" aria-label="Legion photographs">{photos.map(p => <figure><Photo src={p.data.image} alt={p.data.imageAlt} /><figcaption>{p.data.title}</figcaption></figure>)}</section></Layout>
